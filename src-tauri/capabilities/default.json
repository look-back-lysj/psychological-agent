{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "心屿桌面外壳的默认权限：核心能力 + 启动本地后端 sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "xinyu-backend",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
