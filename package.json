{
  "name": "psych-companion",
  "version": "4.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "守岸人 · 大学生情绪陪伴智能体",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "test": "node tests/run.js",
    "bundle": "node build.js",
    "build": "node build.js && pkg main.js --targets node22-win-x64 --output dist/守岸人/守岸人.exe --compress GZip",
    "desktop": "node scripts/build-desktop.js",
    "desktop:dev": "node scripts/build-desktop.js --dev"
  },
