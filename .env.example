# ══════════════════════════════════════════════════════════════
#  守岸人 · 环境变量模板
#
#  推荐做法：直接启动后在网页「设置」里粘贴 DeepSeek API Key，
#  程序会保存到本地 data/config.json（已在 .gitignore 中，不会入库）。
#  下面的环境变量优先级**低于**网页设置，仅作为备选或服务器部署用。
#
#  ⚠️ .env 里不要填写任何真实密钥后提交；仓库只保留本模板。
# ══════════════════════════════════════════════════════════════

# ── 模型（DeepSeek 官方，2026-09 核实）──
# Base URL：官方示例不带 /v1，程序会自行拼接 /chat/completions
LLM_BASE_URL=https://api.deepseek.com
# 推荐 deepseek-flash（便宜、快）；可选 deepseek-v4-pro
LLM_MODEL=deepseek-flash
# 你的 API Key，形如 sk-xxxxxxxxxxxxxxxx；留空表示尚未配置
LLM_API_KEY=
# 思考模式：disabled 推荐（延迟低，且 temperature 才生效）/ enabled
LLM_THINKING=disabled
# 采样温度 0—2，仅非思考模式生效
LLM_TEMPERATURE=0.8
# 单次最大输出 token（情绪陪伴不需要很长）
LLM_MAX_TOKENS=512
# 请求超时（毫秒）
LLM_TIMEOUT_MS=30000

# ── 服务 ──
PORT=3000
# 默认不打开浏览器；本产品是桌面应用，界面由桌面外壳的 WebView 加载；仅调试时设为 1
OPEN_BROWSER=0
# 日志脱敏用的盐，请改成随机长字符串
LOG_SALT=请用随机长字符串填写
